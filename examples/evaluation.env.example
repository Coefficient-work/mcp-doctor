# MCP Doctor evaluation credentials. Copy to:
#   ~/.config/mcp-doctor/evaluation.env
# Then run: chmod 600 ~/.config/mcp-doctor/evaluation.env

# Router breadth layer (required for the autonomous multi-model sweep)
OPENROUTER_API_KEY=

# Native-provider canaries
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional existing MCP Doctor providers
# AI_GATEWAY_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434/v1
