{
  "name": "mcp-doctor",
  "version": "0.4.1",
  "description": "Agent-facing API QA — score MCP readiness, analyze tokens, and catch regressions before agents fail.",
  "type": "module",
  "license": "MIT",
  "author": "Louis Reid",
  "repository": {
    "type": "git",
    "url": "https://github.com/louisreid/mcp-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/louisreid/mcp-doctor/issues"
  },
  "homepage": "https://github.com/louisreid/mcp-doctor#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "agents",
    "evaluation",
    "ci",
    "qa",
    "cli"
  ],
  "bin": {
    "mcp-doctor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "competitors",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:demo": "node dist/cli.js test --demo",
    "analyze": "node dist/cli.js analyze --demo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ai": "^7.0.0",
    "commander": "^13.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
