{
  "name": "mcp-slim",
  "version": "0.1.0",
  "description": "Shrink MCP tool menus from OpenAPI with progressive discovery. Free CLI + demo MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "Louis Reid",
  "repository": {
    "type": "git",
    "url": "https://github.com/louisreid/mcp-slim.git"
  },
  "bugs": {
    "url": "https://github.com/louisreid/mcp-slim/issues"
  },
  "homepage": "https://github.com/louisreid/mcp-slim#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "tokens",
    "ai",
    "agents",
    "cli"
  ],
  "bin": {
    "mcp-slim": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
